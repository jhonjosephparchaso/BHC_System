<!-- include header -->
<%- include('include/_header') %>
<!-- /include header -->

<main id="site-main">
    <div class="container">
        <div class="box-nav d-flex justify-between">
            <div class="filter">
                <a href="/"><i class="fas fa-angle-double-left"></i> All Patients</a>
            </div>
        </div>
        <div class="from-title text-center">
            <h2 class="text-dark">Update Patient</h2>
            <span class="text-light">Edit the form to Update</span>
        </div>

        <form id= "update_user" method="POST">
            <div class="new_user">
                <div class="form-group">
                    <label for="name" class="text-light">Full Name: </label>
                    <input type="hidden" name="id" value="<%= user._id %>">
                    <input type="text" name="name" value="<%= user.name %>" placeholder="Enter Full Name">
                </div>
        
                <div class="form-group">
                    <label for="email" class="text-light">Email: </label>
                    <input type="text" name="email" value="<%= user.email %>" placeholder="Enter Email">
                </div>
        
                <div class="form-group">
                    <label for="gender" class="text-light">Gender: </label>
                    <div class="radio inline">
                        <input type="radio" id="radio-2" name="gender" value="Male" <%= user.gender == 'Male' ? 'checked' : '' %>>
                        <label for="radio-2" class="radio-label">Male</label>
                    </div>
                    <div class="radio inline">
                        <input type="radio" id="radio-3" name="gender" value="Female" <%= user.gender == 'Female' ? 'checked' : '' %>>
                        <label for="radio-3" class="radio-label">Female</label>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="dob" class="text-light" >Date of Birth: </label>
                    <input type="date" name="dob" value="<%= user.dob %>">
                </div>
        
                <div class="form-group">
                    <label for="gender" class="text-light">Status: </label>
                    <div class="radio inline">
                        <input type="radio" id="radio-4" name="status" value="Single" <%= user.status == 'Single' ? 'checked' : '' %>>
                        <label for="radio-4" class="radio-label">Single</label>
                    </div>
                    <div class="radio inline">
                        <input type="radio" id="radio-5" name="status" value="Married" <%= user.status == 'Married' ? 'checked' : '' %>>
                        <label for="radio-5" class="radio-label">Married</label>
                    </div>
                    <div class="radio inline">
                        <input type="radio" id="radio-6" name="status" value="Widowed" <%= user.status == 'Widowed' ? 'checked' : '' %>>
                        <label for="radio-6" class="radio-label">Widowed</label>
                    </div>
                    <div class="radio inline">
                        <input type="radio" id="radio-7" name="status" value="Separated" <%= user.status == 'Separated' ? 'checked' : '' %>>
                        <label for="radio-7" class="radio-label">Separated</label>
                    </div>
                    <div class="radio inline">
                        <input type="radio" id="radio-8" name="status" value="Divorced"<%= user.status == 'Divorced' ? 'checked' : '' %>>
                        <label for="radio-8" class="radio-label">Divorced</label>
                    </div>
                </div>
        
                <div class="form-group">
                    <button type="submit" class="btn text-dark update">UPDATE</button>
                </div>
            </div>
        </form>

    </div>
</main>

<!-- include footer -->
<%- include('include/_footer') %>
<!-- /include footer -->