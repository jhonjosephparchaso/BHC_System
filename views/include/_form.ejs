<form action="/api/users" id= "add_user" method="POST">
    <div class="new_user">
        <div class="form-group">
            <label for="name" class="text-light">Full Name: </label>
            <input type="hidden" name="id" value="">
            <input type="text" name="name" value="" placeholder="Enter Full Name">
        </div>

        <div class="form-group">
            <label for="email" class="text-light">Email: </label>
            <input type="text" name="email" value="" placeholder="Enter Email">
        </div>

        <div class="form-group">
            <label for="gender" class="text-light">Gender: </label>
            <div class="radio inline">
                <input type="radio" id="radio-2" name="gender" value="Male">
                <label for="radio-2" class="radio-label">Male</label>
            </div>
            <div class="radio inline">
                <input type="radio" id="radio-3" name="gender" value="Female">
                <label for="radio-3" class="radio-label">Female</label>
            </div>
        </div>
        
        <div class="form-group">
            <label for="dob" class="text-light">Date of Birth: </label>
            <input type="date" name="dob">
        </div>

        <div class="form-group">
            <label for="gender" class="text-light">Status: </label>
            <div class="radio inline">
                <input type="radio" id="radio-4" name="status" value="Single">
                <label for="radio-4" class="radio-label">Single</label>
            </div>
            <div class="radio inline">
                <input type="radio" id="radio-5" name="status" value="Married">
                <label for="radio-5" class="radio-label">Married</label>
            </div>
            <div class="radio inline">
                <input type="radio" id="radio-6" name="status" value="Widowed">
                <label for="radio-6" class="radio-label">Widowed</label>
            </div>
            <div class="radio inline">
                <input type="radio" id="radio-7" name="status" value="Separated">
                <label for="radio-7" class="radio-label">Separated</label>
            </div>
            <div class="radio inline">
                <input type="radio" id="radio-8" name="status" value="Divorced">
                <label for="radio-8" class="radio-label">Divorced</label>
            </div>
        </div>

        <div class="form-group">
            <button type="submit" class="btn text-dark update">SAVE</button>
        </div>
    </div>
</form>